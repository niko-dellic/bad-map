{
  "name": "bad-map",
  "version": "0.1.0",
  "description": "A semantic low-resolution Braille basemap for MapLibre GL JS",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NEXT_STEPS.md",
    "NOTICE.md",
    "README.md"
  ],
  "main": "./dist/bad-map.js",
  "module": "./dist/bad-map.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bad-map.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "maplibre",
    "maps",
    "vector-tiles",
    "braille",
    "pixel-art"
  ],
  "license": "MIT",
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "pbf": "^5.1.2"
  },
  "peerDependencies": {
    "maplibre-gl": ">=5.0.0 <7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "maplibre-gl": "^5.24.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
