{
  "name": "bad-map",
  "version": "0.10.0",
  "description": "A semantic low-resolution Braille basemap for MapLibre GL JS",
  "author": "niko-dellic",
  "packageManager": "npm@11.6.2",
  "type": "module",
  "sideEffects": false,
  "files": [
    "docs/ARCHITECTURE.md",
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/bad-map.js",
  "module": "./dist/bad-map.js",
  "browser": "./dist/bad-map.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bad-map.js",
      "default": "./dist/bad-map.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niko-dellic/bad-map.git"
  },
  "homepage": "https://github.com/niko-dellic/bad-map#readme",
  "bugs": {
    "url": "https://github.com/niko-dellic/bad-map/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && vite build && node scripts/prune-dist.mjs && tsc -p tsconfig.build.json",
    "build:site": "vite build --config vite.site.config.ts",
    "api:check": "npm run build && node scripts/check-api.mjs",
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:functional": "playwright test e2e/data.spec.ts e2e/camera.spec.ts e2e/ui.spec.ts e2e/lifecycle.spec.ts e2e/landing.spec.ts e2e/docs.spec.ts --grep-invert @performance",
    "test:e2e:performance": "playwright test e2e/lifecycle.spec.ts --grep @performance",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "test:all": "npm test && npm run test:e2e",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run build && node scripts/check-api.mjs && node scripts/test-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "maplibre",
    "maps",
    "vector-tiles",
    "braille",
    "pixel-art",
    "webgl",
    "typescript",
    "geojson",
    "heatmap",
    "cartography"
  ],
  "license": "MIT",
  "dependencies": {
    "@types/geojson": "^7946.0.16"
  },
  "peerDependencies": {
    "maplibre-gl": ">=5.0.0 <7"
  },
  "devDependencies": {
    "@fontsource/silkscreen": "^5.3.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@phosphor-icons/web": "^2.1.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "maplibre-gl": "^5.24.0",
    "pbf": "^5.1.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vitest": "^3.2.4"
  }
}
